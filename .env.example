# ── Application ──
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=${APP_URL}
NEXT_PUBLIC_API_URL=${API_URL}

# ── Database ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── Auth (Better Auth) ──
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=${API_URL}

# ── Queue & Cache (Redis) ──
REDIS_URL=redis://localhost:6379

# ── Event Bus (NATS) ──
NATS_URL=nats://localhost:4222

# ── Object Storage (MinIO) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=default
MINIO_USE_SSL=false
# MINIO_PUBLIC_URL=http://localhost:9000  # Override public URL if behind proxy

# ── Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mustaka.id
# Kosongkan SMTP config untuk development → email akan log ke console

# ── Modules ──
ACTIVE_MODULES=absence,admission,violations
