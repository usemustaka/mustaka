{
  "name": "mustaka",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "cd apps/api && bun run build & cd apps/web && bun run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:push": "cd packages/db && bun run db:push",
    "db:generate": "cd packages/db && bun run db:generate",
    "auth:generate": "cd packages/auth && bun run auth:generate"
  }
}
